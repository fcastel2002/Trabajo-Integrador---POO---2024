    <codegeneration>
      <codegenerator language="Python">
        <sourcecode id="uKn6Ime9Ze7Wt" value="self.puerto_serial=puerto_serial&#10;self.baudios=baudios&#10;self.estado_conexion=&quot;desconectado&quot;&#10;self.motores_activos=False&#10;self.efector_estado=&quot;desactivado&quot;&#10;self.aprendiendo=False&#10;self.actividad=&quot;inactivo&quot;&#10;self.homming_realizado=False&#10;self.archivo_ordenes_ejecutadas=GestorDeArchivos(&quot;ordenes_ejecutadas.txt&quot;)&#10;self.archivo_ordenes_solicitadas=GestorDeArchivos(&quot;ordenes_solicitadas.txt&quot;)&#10;self.archivo_aprendizaje=None&#10;self.inicio_actividad=None&#10;self.ordenes_totales=0&#10;self.errores=[]&#10;"/>
        <sourcecode id="uYUJVJVROVrGr" value="mensajes=[]&#10;if self.estado_conexion==&quot;conectado&quot;:&#10;  raise ErrorDeEstado(3)&#10;&#10;try:&#10;  self.serial_robot=serial.Serial(self.puerto_serial,self.baudios)&#10;  self.serial_robot.timeout=2&#10;  self.estado_conexion=&quot;conectado&quot;&#10;  self.serial_robot.reset_input_buffer()&#10;  self.serial_robot.reset_output_buffer()&#10;  time.sleep(2)&#10;  while self.serial_robot.in_waiting&gt;0:&#10;    mensaje=self.serial_robot.readline().decode().strip()&#10;    mensajes.append(mensaje)&#10;&#10;  mensajes.append(&quot;Exito: Conexion establecida\n&quot;)&#10;  return mensajes&#10;&#10;except Exception:&#10;  raise ErrorDeConexion(1)&#10;&#10;"/>
        <sourcecode id="u4VFl6sH3HSi9" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeEstado(4)&#10;&#10;self.serial_robot.close()&#10;self.estado_conexion=&quot;desconectado&quot;&#10;return&quot;Exito: Conexion terminada\n&quot;&#10;"/>
        <sourcecode id="uJgfrudxZbk8n" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeConexion(1)&#10;&#10;if self.motores_activos:&#10;  raise ErrorDeEstado(2)&#10;&#10;if self.inicio_actividad is None:&#10;  self.inicio_actividad=time.time()&#10;&#10;self.motores_activos=True&#10;gcode=&quot;M17&quot;&#10;try:&#10;  return self._registrar_comando(gcode)&#10;&#10;except Exception as e:&#10;  self.motores_activos=False&#10;  raise e&#10;&#10;"/>
        <sourcecode id="u1C5lpzNnkp7A" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeConexion(1)&#10;&#10;if not self.motores_activos:&#10;  raise ErrorDeEstado(1)&#10;&#10;self.motores_activos=False&#10;gcode=&quot;M18&quot;&#10;try:&#10;return self._registrar_comando(gcode)except Exception:&#10;  self.motores_activos=True&#10;  raise Exception&#10;&#10;"/>
        <sourcecode id="uYOJBMDIQThvi" value="self.ordenes_totales+=1&#10;comando_json=json.dumps(:&#10;  &quot;comando&quot;:comando,&quot;timestamp&quot;:time.strftime('%Y-%m-%d %H:%M:%S',time.localtime())&#10;)&#10;self.archivo_ordenes_solicitadas.guardar_linea(comando_json)&#10;try:&#10;  self.serial_robot.write((comando+&quot;\r\n&quot;).encode())&#10;&#10;except Exception:&#10;  raise ErrorDeConexion(1)&#10;&#10;self.serial_robot.reset_input_buffer()&#10;respuestas=[]&#10;time.sleep(2)&#10;while self.serial_robot.in_waiting&gt;0:&#10;  respuesta=self.serial_robot.readline().decode().strip()&#10;  respuestas.append(respuesta)&#10;&#10;if not respuestas:&#10;  self.errores.append(comando)&#10;  return:&#10;    &quot;error&quot;:&quot;No se recibio respuesta del robot&quot;&#10;&#10;&#10;for respuesta in respuestas:&#10;  if&quot;ERROR&quot;in respuesta.upper():&#10;    self.errores.append(comando)&#10;    return:&#10;      &quot;error&quot;:respuesta&#10;&#10;&#10;  try:&#10;    self.archivo_ordenes_ejecutadas.guardar_linea(f&quot;{comando} -&gt; {respuesta}&quot;)&#10;&#10;  except Exception as e:&#10;    self.errores.append(comando)&#10;    return:&#10;      &quot;error&quot;:f&quot;{e}&quot;&#10;&#10;&#10;&#10;if self.aprendiendo and self.archivo_aprendizaje:&#10;  self.archivo_aprendizaje.guardar_linea(comando)&#10;&#10;return:&#10;  &quot;respuesta_robot&quot;:respuestas&#10;&#10;"/>
        <sourcecode id="ufJJEse0WHgIm" value="reporte=f&quot;Estado de conexion: {self.estado_conexion}\n&quot;&#10;reporte+=f&quot;Estado de actividad: {'Activo' if self.motores_activos else 'Inactivo'}\n&quot;&#10;if self.inicio_actividad:&#10;  reporte+=f&quot;Actividad iniciada en: {time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(self.inicio_actividad))}\n&quot;&#10;&#10;reporte+=f&quot;Numero de ordenes solicitadas: {self.ordenes_totales}\n&quot;&#10;reporte+=f&quot;Numero de errores: {len(self.errores)}\n&quot;&#10;if self.errores:&#10;  reporte+=f&quot;Ordenes con errores: {self.errores}\n&quot;&#10;&#10;reporte+=f&quot;Numero de ordenes ejecutadas: {self.archivo_ordenes_ejecutadas.contar_lineas()}\n&quot;&#10;return reporte&#10;"/>
        <sourcecode id="u9cvJZYYjV1ah" value="if not self.motores_activos:&#10;  raise ErrorDeConexion(2)&#10;&#10;if activar:&#10;  if self.aprendiendo:&#10;    raise ErrorDeEstado(7)&#10;&#10;  self.aprendiendo=True&#10;  self.archivo_aprendizaje=GestorDeArchivos(f&quot;{nombre_archivo}.txt&quot;)&#10;  return&quot;Modo aprendizaje activado\n&quot;&#10;&#10;else:&#10;  if not self.aprendiendo:&#10;    return&quot;El robot ya esta fuera del modo aprendizaje\n&quot;&#10;&#10;  self.aprendiendo=False&#10;  self.archivo_aprendizaje=None&#10;  return&quot;Modo aprendizaje desactivado\n&quot;&#10;&#10;"/>
        <sourcecode id="uZeA5BeJRlye6" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeConexion(1)&#10;&#10;if not self.motores_activos:&#10;  raise ErrorDeConexion(2)&#10;&#10;if self.aprendiendo:&#10;  raise ErrorDeEstado(9)&#10;&#10;if archivo is not None:&#10;  comandos=archivo&#10;  print(comandos)&#10;  archivo_control_automatico=GestorDeArchivos(&quot;ArchivoRecibido.txt&quot;)&#10;&#10;else:&#10;  archivo_control_automatico=GestorDeArchivos(f&quot;{nombre_archivo}.txt&quot;)&#10;  try:&#10;    comandos=archivo_control_automatico.leer_archivo()&#10;&#10;  except Exception:&#10;    raise ErrorArchivos(2,nombre_archivo)&#10;&#10;&#10;resultados=[]&#10;for comando in comandos:&#10;  comando=comando.strip()&#10;  if archivo is not None:&#10;    archivo_control_automatico.escribir_archivo(comando)&#10;&#10;  respuestas=self._registrar_comando(comando)&#10;  if&quot;error&quot;in respuestas:&#10;    resultados.append(f&quot;Comando: {comando} - Error: {respuestas['error']}&quot;)&#10;&#10;  else:&#10;    for respuesta in respuestas['respuesta_robot']:&#10;      resultados.append(f&quot;Comando: {comando} - Respuesta: {respuesta}&quot;)&#10;&#10;&#10;&#10;resultados.append(&quot;Ejecucion automatica completada\n&quot;)&#10;return&quot;\n&quot;.join(resultados)&#10;"/>
        <sourcecode id="uZRfpUi13OX8o" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeConexion(1)&#10;&#10;if not self.motores_activos:&#10;  raise ErrorDeConexion(2)&#10;&#10;gcode=f&quot;G1 X{x} Y{y} Z{z} F{velocidad}&quot;&#10;resultado=self._registrar_comando(gcode)&#10;mensajes=[]&#10;if&quot;error&quot;in resultado:&#10;  mensajes.append(resultado[&quot;error&quot;])&#10;  return mensajes&#10;&#10;mensajes.append(f&quot;Exito: Efector movido a (X={x}, Y={y}, Z={z}) con velocidad {velocidad}\n&quot;)&#10;return mensajes&#10;"/>
        <sourcecode id="uisnNq0lk50UN" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeConexion(1)&#10;&#10;if not self.motores_activos:&#10;  raise ErrorDeConexion(2)&#10;&#10;velocidad_default=1000&#10;gcode=f&quot;G1 X{x} Y{y} Z{z} F{velocidad_default}&quot;&#10;resultado=self._registrar_comando(gcode)&#10;mensajes=[]&#10;if&quot;error&quot;in resultado:&#10;  mensajes.append(resultado[&quot;error&quot;])&#10;  return mensajes&#10;&#10;mensajes.append(f&quot;Exito: Efector movido a (X={x}, Y={y}, Z={z}) con velocidad {velocidad_default}\n&quot;)&#10;return mensajes&#10;"/>
        <sourcecode id="uZaiVe39LdQF7" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeConexion(1)&#10;&#10;if not self.motores_activos:&#10;  raise ErrorDeConexion(2)&#10;&#10;if accion=='1':&#10;  if self.efector_estado==&quot;activado&quot;:&#10;    raise ErrorDeEstado(5)&#10;&#10;  gcode=&quot;M3&quot;&#10;  self.efector_estado=&quot;activado&quot;&#10;&#10;elif accion=='0':&#10;  if self.efector_estado==&quot;desactivado&quot;:&#10;    raise ErrorDeEstado(6)&#10;&#10;  gcode=&quot;M5&quot;&#10;  self.efector_estado=&quot;desactivado&quot;&#10;&#10;else:&#10;  raise ErrorDeParametros(3)&#10;&#10;resultado=self._registrar_comando(gcode)&#10;if&quot;error&quot;in resultado:&#10;  return resultado[&quot;error&quot;]&#10;&#10;return f&quot;Exito: Efector {'activado' if accion == '1' else 'desactivado'}\n&quot;&#10;"/>
        <sourcecode id="uCJZOYatAXI3C" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeConexion(1)&#10;&#10;if not self.motores_activos:&#10;  raise ErrorDeConexion(2)&#10;&#10;resultado=self._registrar_comando(&quot;G28&quot;)&#10;mensajes=[]&#10;if&quot;error&quot;in resultado:&#10;  mensajes.append(resultado[&quot;error&quot;])&#10;  return mensajes&#10;&#10;self.homming_realizado=True&#10;mensajes.append(&quot;Ã‰xito: Homming realizado\n&quot;)&#10;return mensajes&#10;"/>
        <sourcecode id="ufA6hLcZg5Lpv" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeConexion(1)&#10;&#10;if not self.motores_activos:&#10;  raise ErrorDeConexion(2)&#10;&#10;resultado=self._registrar_comando(&quot;G28&quot;)&#10;if&quot;error&quot;in resultado:&#10;  return resultado[&quot;error&quot;]&#10;&#10;return&quot;Ã‰xito: Efector movido a la posiciÃ³n de origen\n&quot;&#10;"/>
        <sourcecode id="uOvH6NbjdTQac" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeConexion(1)&#10;&#10;mensajes=[]&#10;respuestas=self._registrar_comando(&quot;M114&quot;)&#10;if&quot;error&quot;in respuestas:&#10;  mensajes.append(respuestas[&quot;error&quot;])&#10;  return mensajes&#10;&#10;for respuesta in respuestas['respuesta_robot']:&#10;  mensajes.append(respuesta)&#10;&#10;return mensajes&#10;"/>
        <sourcecode id="uHapYiQbokZ6e" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeConexion(1)&#10;&#10;resultado=self._registrar_comando(&quot;G90&quot;)&#10;mensajes=[]&#10;if&quot;error&quot;in resultado:&#10;  mensajes.append(resultado[&quot;error&quot;])&#10;  return mensajes&#10;&#10;mensajes.append(resultado)&#10;mensajes.append(&quot;Modo de coordenadas absolutas activado\n&quot;)&#10;return mensajes&#10;"/>
        <sourcecode id="u9oe5dSyIlqC8" value="if self.estado_conexion==&quot;desconectado&quot;:&#10;  raise ErrorDeConexion(1)&#10;&#10;resultado=self._registrar_comando(&quot;G91&quot;)&#10;mensajes=[]&#10;if&quot;error&quot;in resultado:&#10;  mensajes.append(resultado[&quot;error&quot;])&#10;  return mensajes&#10;&#10;mensajes.append(resultado)&#10;mensajes.append(&quot;Modo relativo activado\n&quot;)&#10;return mensajes"/>
