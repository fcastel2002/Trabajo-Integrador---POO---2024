        <sourcecode id="uygOZ0xpheiHz" value="self.server=SimpleXMLRPCServer((self.ip,self.puerto),allow_none=True,logRequests=False)&#10;self.server.register_function(self.interpreta_comando,&quot;Interpreta_Comando&quot;)&#10;self.server_thread=threading.Thread(target=self._iniciar_servidor)&#10;self.server_thread.daemon=True&#10;self.server_thread.start()&#10;print(f&quot;Servidor RPC iniciado en {self.ip}:{self.puerto}\n&quot;)&#10;"/>
        <sourcecode id="uam6gFC29jOUC" value="try:&#10;  self.server.serve_forever()&#10;&#10;except KeyboardInterrupt:&#10;  self.server.shutdown()&#10;&#10;"/>
        <sourcecode id="uoCrNziTQVod5" value="if self.server:&#10;  print(&quot;Iniciando cierre del servidor...&quot;)&#10;  self.server.shutdown()&#10;  self.server.server_close()&#10;  self.server_thread.join()&#10;  print(&quot;Servidor cerrado correctamente.&quot;)&#10;&#10;"/>
        <sourcecode id="uizs2ayvgwtEL" value="comandos_disponibles=[&quot;login&quot;,&quot;cerrar sesion&quot;,&quot;conectar con servidor&quot;,&#10;&quot;conectar&quot;,&quot;desconectar&quot;,&quot;activar_motores&quot;,&quot;desactivar_motores&quot;,&#10;&quot;mover_efector&quot;,&quot;homming&quot;,&quot;reportar_estado&quot;,&quot;reportar_posicion&quot;,&#10;&quot;actuar_efector&quot;,&quot;ejecutar_automatico&quot;,&quot;Cambiar_modo&quot;,&quot;comandos&quot;,&quot;salir&quot;&#10;"/>
        <sourcecode id="uGiDDNC1tbFbf" value="if not self._validar_usuario(usuario,clave):&#10;  return:&#10;    &quot;error&quot;:&quot;Acceso denegado: Usuario o clave incorrectos&quot;&#10;&#10;&#10;try:&#10;  resultado=self._ejecutar_comando(comando,parametros)&#10;  self.logger.registrar_log(comando,&quot;127.0.0.1&quot;,usuario,True)&#10;  return resultado&#10;&#10;except Exception as e:&#10;  self.logger.registrar_log(&quot;error&quot;,&quot;127.0.0.1&quot;,&quot;sistema&quot;,False)&#10;  return:&#10;    &quot;error&quot;:f&quot;Error al interpretar el comando: {str(e)}&quot;&#10;&#10;&#10;"/>
        <sourcecode id="ujJfehbYN0nu3" value="mensajes=:&#10;&#10;  1:&quot;Falla: No hay conexion con el sistema. Verifique el comando 'conectar'.&quot;,2:&quot;Falla: El sistema esta inactivo. Verifique que los motores esten encendidos.&quot;&#10;&#10;self.mensaje=mensajes.get(tipo,&quot;Error de conexion desconocido.&quot;)&#10;"/>
        <sourcecode id="uDnOO0vpQp76P" value="return self.mensaje&#10;"/>
        <sourcecode id="uVIdEt15qHYeO" value="mensajes=:&#10;&#10;  1:&quot;Parametros fuera de los limites aceptados.&quot;,2:&quot;Numero de parametros incorrecto. Use 'ayuda &lt;comando&gt;' para mas informacion.&quot;,3:&quot;Parametros invalidos. Use 'ayuda &lt;comando&gt;' para mas informacion.&quot;&#10;&#10;self.mensaje=mensajes.get(tipo,&quot;Error de parametros.&quot;)&#10;"/>
        <sourcecode id="uPS6TQFuEl33c" value="return self.mensaje&#10;"/>
        <sourcecode id="uXuw2mwFJfWId" value="mensajes=:&#10;&#10;  1:&quot;Los motores ya estan apagados.&quot;,2:&quot;Los motores ya estan encendidos.&quot;,3:&quot;La conexiÃ³n ya esta activa.&quot;,4:&quot;La conexiÃ³n ya esta inactiva.&quot;,5:&quot;El efector ya esta activado.&quot;,6:&quot;El efector ya esta desactivado.&quot;,7:&quot;El robot ya esta en modo aprendizaje.&quot;,8:&quot;El robot no esta en modo aprendizaje.&quot;,9:&quot;No se puede ejecutar en modo aprendizaje activo.&quot;&#10;&#10;self.mensaje=mensajes.get(tipo,&quot;Error de estado.&quot;)&#10;"/>
        <sourcecode id="ujH9qfjma9VPv" value="return self.mensaje&#10;"/>
        <sourcecode id="uA82iT7ppaaXP" value="mensajes=:&#10;&#10;  1:&quot;No se pudo escribir en el archivo&quot;,2:f&quot;El archivo {nombre_archivo}.txt no existe.&quot;&#10;&#10;self.mensaje=mensajes.get(tipo,&quot;Error de estado.&quot;)&#10;"/>
        <sourcecode id="utqQxgjGVVZBC" value="return self.mensaje"/>
